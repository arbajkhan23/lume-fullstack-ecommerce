# ==========================================================================
# LUMÉ Backend — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.
# ==========================================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas connection string or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lume?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_a_different_long_random_string
ADMIN_JWT_EXPIRES_IN=1d

# Cloudinary (image storage for products, categories, banners)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — comma-separated list of allowed origins (your frontend + admin panel)
CLIENT_URL=https://arbajkhan23.github.io
ADMIN_URL=http://localhost:5174

# Initial super admin (used only by the seed script, first run)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@lume-studio.com
SEED_ADMIN_PASSWORD=ChangeMe123!
